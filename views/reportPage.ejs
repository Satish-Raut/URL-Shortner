<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="ejsStyle.css">
</head>

<body>

    <%- include('header') %>

        <div class="dashboard-text">
            <h1>
                <span>Student</span><br>
                <span>Dashboard</span>
            </h1>
        </div>


        <section class="report-section">
            <h1>Student Report Card</h1>

            <%# ejs Comments%>
                <!-- This is a HTML Comment -->

                <ul>
                    <% student.map((stud)=>{ %>
                        <li>
                            <p>Name: <b>
                                    <%= stud.name %>
                                </b></p>

                            <p>Institute: <b>
                                    <%= stud.Institute %>
                                </b></p>

                            <p>Specialization: <b>
                                    <%= stud.Specialization %>
                                </b></p>
                        </li>
                        <% }) %>
                </ul>
        </section>


</body>

</html>