<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>URL Shortener</title>
    <link rel="stylesheet" href="style.css" />
</head>

<body>
    <div class="container">

        <h1>URL Shortener</h1>

        <form id="shorten-form" action="/" method="post">
            <div class="field">
                <label for="url">Enter URL</label>
                <input type="url" name="url" id="url" placeholder="https://example.com" required />
            </div>

            <div class="field">
                <label for="shortcode">Enter Shortcode</label>
                <input type="text" name="shortCode" id="shortcode" placeholder="my-link" required />
            </div>

            <button type="submit">Shorten URL</button>
        </form>

        <h2>Shortened URLs</h2>

        <ul id="shortened-urls">

            <% links.map(({shortCode, url})=> { %>
                <li class="url-item">
                    <a href="/<%= shortCode %>" target="_blank">
                        <%= host %>/<%= shortCode %>
                    </a>
                    <span class="original-url">
                        <%= url %>
                    </span>
                </li>
                <% }) %>
        </ul>

    </div>

